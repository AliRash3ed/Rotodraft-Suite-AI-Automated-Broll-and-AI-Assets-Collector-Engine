      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is RotoDraft Suite?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "RotoDraft Suite is a 100% free and open-source automated script-to-b-roll video creation engine that converts voiceover scripts into timeline-ready 1080p/4K stock video clips with local FFmpeg transcoding and direct NLE project exports for Premiere Pro, DaVinci Resolve, and CapCut."
          }
        },
        {
          "@type": "Question",
          "name": "How does RotoDraft Suite compare to Pictory AI and InVideo AI?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Unlike Pictory AI ($49/month) and InVideo AI ($35/month), RotoDraft Suite is 100% free and open-source forever. It allows users to bring their own API keys for any AI model (OpenRouter, Gemini, Groq, OpenAI, Claude, Ollama, DeepSeek), searches 9 stock vaults in parallel, operates locally with zero cloud privacy risks, and exports native timeline files for Adobe Premiere Pro, DaVinci Resolve, and CapCut."
          }
        },
        {
          "@type": "Question",
          "name": "Can I download the video clips directly without opening an editor?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. RotoDraft Suite provides a 1-Click ZIP download of all trimmed clips, individual MP4 download buttons for each clip, and an automated Full Master Video MP4 stitcher."
          }
        },
        {
          "@type": "Question",
          "name": "Can I run RotoDraft Suite in Google Colab?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. RotoDraft Suite includes an official 1-Click Google Colab notebook for running the complete web studio on cloud GPU acceleration with instant passwordless Cloudflare Tunnel URLs."
