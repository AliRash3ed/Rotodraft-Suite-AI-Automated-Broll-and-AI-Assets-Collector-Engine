# ═══════════════════════════════════════════════════════════════
# AI B-ROLL & STOCK MEDIA COLLECTOR PRO — CONFIGURATION TEMPLATE
# Copy this file to .env and add your API keys (All are optional / free tiers available)
# ═══════════════════════════════════════════════════════════════

# AI Brain Providers (Choose at least one)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=minimax/minimax-m3:free

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

COHERE_API_KEY=
COHERE_MODEL=command-r-08-2024

OLLAMA_ENDPOINT=http://localhost:11434/v1/chat/completions
OLLAMA_MODEL=llama3.2

# Custom OpenAI-Compatible Endpoint (vLLM, LM Studio, Together AI, etc.)
CUSTOM_AI_NAME=Custom LLM
CUSTOM_AI_ENDPOINT=
CUSTOM_AI_KEY=
CUSTOM_AI_MODEL=default
CUSTOM_AI_THINKING=false

# Stock Media API Keys (Free Quotas Available)
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_API_KEY=
COVERR_API_KEY=
STORYBLOCKS_API_KEY=
PINTEREST_SESSION_COOKIE=

# Pipeline Defaults
DEFAULT_AI_PROVIDER=openrouter
DEFAULT_CLIP_DURATION=3.0
DEFAULT_QUALITY=1080p
DEFAULT_ASPECT_RATIO=16:9
DEFAULT_TRANSITION=cut
COLOR_PRESET=none

# Concurrency & Performance
MAX_PARALLEL_DOWNLOADS=5
MAX_PARALLEL_SEARCHES=6
MAX_PARALLEL_FFMPEG=4

# Network Proxy (Optional)
HTTP_PROXY=
HTTPS_PROXY=
