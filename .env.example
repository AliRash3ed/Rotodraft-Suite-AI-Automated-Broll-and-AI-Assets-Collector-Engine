# RotoDraft Suite - Environment Configuration

# AI Providers (Bring Your Own Key - Optional)
# By default, RotoDraft uses 100% Free models (openrouter/free, liquid/lfm-2.5-2.6b:free, meta-llama/llama-3.3-70b-instruct:free)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Secondary / Backup AI (Cohere Free Tier)
COHERE_API_KEY=
COHERE_MODEL=command-r-08-2024

# Stock Media API Keys (Free on Pexels & Pixabay)
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Server Settings
HOST=127.0.0.1
PORT=8000
DEBUG=False
